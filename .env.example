# Database (Railway injects DATABASE_URL automatically, but normalize postgres:// → postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/qccsai

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MONITORED_GROUP_IDS=   # Comma-separated: -100xxx,-100yyy
TELEGRAM_ANNOUNCEMENT_GROUP_ID= # Single group ID

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=       # Unsigned preset for frontend direct upload

# Jira
JIRA_DOMAIN=                    # yourcompany.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_WEBHOOK_SECRET=

# Access control (comma-separated PM/QC emails)
PM_QC_EMAILS=

# App URLs
BACKEND_BASE_URL=               # Full Railway URL e.g. https://qc-backend.up.railway.app
FRONTEND_URL=                   # For CORS
